# Copy file này thành `.env` khi chạy Cart Service local.
# Không commit `.env`, password PostgreSQL hoặc internal service token lên Git.
#
# Quy tắc theo môi trường:
# - Chạy trực tiếp trên máy: dùng localhost và port expose của từng service.
# - Docker Compose/Kubernetes: đổi localhost thành tên service/DNS nội bộ.
# - Production: inject secret từ Secret Manager/Kubernetes Secret.

# ============================================================================
# 01 · Runtime và HTTP API
# Cart Service quản lý giỏ hàng, không nhận request frontend trực tiếp.
# ============================================================================

APP_VERSION=1.0.0                                      # Version hiển thị trong health response
NODE_ENV=development                                   # development | test | production
PORT=3010                                              # Port local; Docker Compose dùng port nội bộ 3003

# ============================================================================
# 02 · PostgreSQL - nguồn dữ liệu của Cart Service
# Cart giữ cart, cart item và trạng thái checkout; không dùng synchronize.
# ============================================================================

POSTGRES_HOST=localhost                                # Docker/K8s: postgres hoặc DNS PostgreSQL managed
POSTGRES_PORT=5432                                     # Cổng PostgreSQL
POSTGRES_USER=bin_ecommerce                             # User kết nối database
POSTGRES_PASSWORD=
POSTGRES_DB=bin_ecommerce_cart                          # Database riêng của Cart Service

# ============================================================================
# 03 · Product Service - dependency kiểm tra sản phẩm
# Cart đọc thông tin sản phẩm qua HTTP để xác thực trạng thái, giá và tồn kho.
# ============================================================================

PRODUCT_SERVICE_URL=http://localhost:3008               # Docker/K8s: http://product-service:3008

# ============================================================================
# 04 · Xác thực request nội bộ
# Gateway hoặc service nội bộ phải dùng cùng token với Cart Service.
# Không đưa token thật vào frontend hoặc commit giá trị production lên Git.
# ============================================================================

INTERNAL_SERVICE_TOKEN=

# ============================================================================
# 05 · Log và vận hành database
# Migration là cách duy nhất thay đổi schema; không bật synchronize tùy ý.
# ============================================================================

TYPEORM_LOGGING=false                                   # true chỉ nên dùng khi cần điều tra SQL local
